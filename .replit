modules = ["nodejs-20", "web"]

[nix]
channel = "stable-25_05"
packages = ["yakut"]

[agent]
expertMode = true

[env]
XDG_CONFIG_HOME = "/home/runner/workspace/.tools/xdg/config"
XDG_DATA_HOME = "/home/runner/workspace/.tools/xdg/data"
XDG_CACHE_HOME = "/home/runner/workspace/.tools/xdg/cache"
XDG_STATE_HOME = "/home/runner/workspace/.tools/xdg/state"
NPM_CONFIG_PREFIX = "/home/runner/workspace/.tools/npm"
PATH = "/home/runner/workspace/.tools/npm/bin:/home/runner/workspace/.bin:/home/runner/.local/bin:/home/runner/.nix-profile/bin:/nix/var/nix/profiles/default/bin:/usr/local/bin:/usr/bin:/bin"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8765
externalPort = 3000

[[ports]]
localPort = 8766
externalPort = 3001

[[ports]]
localPort = 8767
externalPort = 3002

[[ports]]
localPort = 8799
externalPort = 3003

[[ports]]
localPort = 8801
externalPort = 4200

[[ports]]
localPort = 8803
externalPort = 5000

[[ports]]
localPort = 8805
externalPort = 5173

[[ports]]
localPort = 8807
externalPort = 6000

[[ports]]
localPort = 8809
externalPort = 6800

[[ports]]
localPort = 8811
externalPort = 8000
