{
  "version": 1,
  "tabs": [
    { "key": "ctrl+1", "route": "#/ive", "label": "IVE", "teach": "opens the instrument view" },
    {
      "key": "ctrl+2",
      "route": "#/evidence",
      "label": "Evidence",
      "teach": "opens the evidence log"
    },
    {
      "key": "ctrl+3",
      "route": "#/terminal",
      "label": "Terminal",
      "teach": "opens the command console"
    },
    {
      "key": "ctrl+4",
      "route": "#/mission",
      "label": "Mission Control",
      "teach": "opens mission control"
    },
    {
      "key": "ctrl+5",
      "route": "#/twin",
      "label": "Spatial Twin",
      "teach": "opens the spatial twin"
    },
    { "key": "ctrl+6", "route": "#/watchdog", "label": "Watchdog", "teach": "opens rail health" },
    { "key": "ctrl+7", "route": "#/receipts", "label": "Receipts", "teach": "opens receipts" },
    { "key": "ctrl+8", "route": "#/pools", "label": "Ubuntu Pools", "teach": "opens Ubuntu Pools" },
    { "key": "ctrl+9", "route": "#/bridges", "label": "Bridges", "teach": "opens device bridges" },
    { "key": "ctrl+0", "route": "#/settings", "label": "Settings", "teach": "opens settings" }
  ],
  "actions": [
    { "key": "ctrl+a", "action": "authorise", "teach": "opens the two-gate handshake" },
    { "key": "ctrl+b", "action": "bind", "teach": "binds a new device" },
    {
      "key": "ctrl+c",
      "action": "copy",
      "teach": "copies the current selection",
      "native": "never prevented — text selection copies natively"
    },
    { "key": "ctrl+d", "action": "declare", "teach": "opens the declare-state dialog" },
    { "key": "ctrl+e", "action": "export", "teach": "exports as a signed artifact" },
    { "key": "ctrl+f", "action": "find", "teach": "opens search" },
    { "key": "ctrl+g", "action": "gate", "teach": "opens the two-gate status" },
    { "key": "ctrl+h", "action": "hide", "teach": "hides this panel" },
    { "key": "ctrl+i", "action": "inspect", "teach": "inspects the selected element" },
    { "key": "ctrl+j", "action": "journal", "teach": "jumps to the journal entry" },
    {
      "key": "ctrl+k",
      "action": "palette",
      "teach": "opens the command palette",
      "app_owned": "the palette binds this itself — the layer counts the use and never double-opens"
    },
    { "key": "ctrl+l", "action": "lock", "teach": "locks this surface" },
    { "key": "ctrl+m", "action": "mark", "teach": "marks the event noteworthy" },
    {
      "key": "ctrl+n",
      "action": "note",
      "teach": "attaches a note to the event",
      "reserved": "browser-reserved on desktop Chrome/Edge/Firefox — fires in installed PWA contexts only; Lindiwe never teaches it"
    },
    { "key": "ctrl+o", "action": "open", "teach": "opens the item in a new pane" },
    { "key": "ctrl+p", "action": "pin", "teach": "pin this panel" },
    { "key": "ctrl+q", "action": "query", "teach": "opens the query builder" },
    { "key": "ctrl+r", "action": "refresh", "teach": "forces a refresh from source" },
    { "key": "ctrl+s", "action": "seal", "teach": "seals the chain segment" },
    {
      "key": "ctrl+t",
      "action": "trace",
      "teach": "traces the provenance of the item",
      "reserved": "browser-reserved on desktop Chrome/Edge/Firefox — fires in installed PWA contexts only; Lindiwe never teaches it"
    },
    { "key": "ctrl+u", "action": "unpin", "teach": "unpin this panel" },
    { "key": "ctrl+v", "action": "verify", "teach": "verify against the chain" },
    {
      "key": "ctrl+w",
      "action": "watch",
      "teach": "adds the item to Watchdog",
      "reserved": "browser-reserved on desktop Chrome/Edge/Firefox — CLOSES THE TAB in plain desktop Chrome; bound for PWA contexts, never taught, never shown without its warning"
    },
    { "key": "ctrl+x", "action": "snapshot", "teach": "captures a signed screenshot" },
    { "key": "ctrl+y", "action": "yield", "teach": "returns to the default surface" },
    { "key": "ctrl+z", "action": "rollback", "teach": "rolls back the last reversible action" },
    { "key": "ctrl+shift+h", "action": "reveal", "teach": "reveals the last hidden panel" },
    { "key": "ctrl+shift+p", "action": "pip", "teach": "pop out to PiP" }
  ],
  "chords": [
    { "from": "g", "to": "i", "route": "#/ive" },
    { "from": "g", "to": "e", "route": "#/evidence" },
    { "from": "g", "to": "t", "route": "#/terminal" },
    { "from": "g", "to": "m", "route": "#/mission" },
    { "from": "g", "to": "w", "route": "#/twin" },
    { "from": "g", "to": "h", "route": "#/watchdog" },
    { "from": "g", "to": "r", "route": "#/receipts" },
    { "from": "g", "to": "p", "route": "#/pools" },
    { "from": "g", "to": "b", "route": "#/bridges" },
    { "from": "g", "to": "s", "route": "#/settings" }
  ]
}
