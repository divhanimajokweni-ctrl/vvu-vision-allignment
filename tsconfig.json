{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "examples",
    "skills",
    "mini-services",
    "open-source",
    "commercial",
    "scripts",
    ".github",
    "vvu-trust",
    "proofbridge",
    "obsidian-plugin",
    "src/vvu",
    "src/lib/vvu-utils.ts",
    "src/server",
    "src/types",
    "src/app/api/bridge",
    "src/app/api/docs",
    "src/app/api/estate",
    "src/app/api/field",
    "src/app/api/governance",
    "src/app/api/guardian",
    "src/app/api/icsh",
    "src/app/api/ops",
    "src/app/api/proximity",
    "src/app/api/safegrid",
    "src/app/api/vvu",
    "src/app/api/watchdog",
    "src/app/api/yolo",
    "src/app/api/fleet",
    "src/app/api/gis",
    "src/app/api/integrity",
    "src/app/api/traffic",
    "src/components/analytics",
    "src/components/broadcast",
    "src/components/capability",
    "src/components/commercial",
    "src/components/docs",
    "src/components/fieldkit",
    "src/components/fleet",
    "src/components/governance",
    "src/components/holocom",
    "src/components/icsh",
    "src/components/manifest",
    "src/components/metro",
    "src/components/ops",
    "src/components/outreach",
    "src/components/pwa",
    "src/components/receipts",
    "src/components/spatial",
    "src/components/support",
