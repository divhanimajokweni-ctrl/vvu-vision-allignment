}

// ─────────────────────────────────────────────────────────────────────────────
// SECTION: Proximity — record layer for the proximity stream (R60).
// Reconstructed from src/server/proximity/{pipeline,verify}.ts. The eventId
// is the join key to the WORM seal index; source/subjectId carry the
// human-readable context the verifier's chain view joins in.
// ─────────────────────────────────────────────────────────────────────────────

model ProximityRecord {
  id            String   @id @default(cuid())
  eventId       String   @unique
  source        String
  subjectId     String
  distanceCm    Int
  rssiDbm       Int
  batteryMv     Int
  dwellMs       Int
  riskMilli     Int
  occurredAt    String
  gateDecision  String
  gateReason    String
  action        String
  rulesFired    String
  sealRef       String?
  ingestedAt    DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────────────────
// SECTION: Watchboard — moved-board ledger (R128/R130/R133/R135).
// Reconstructed from src/app/api/estate/watchboard/{route,ledger/route}.ts.
// Each row is ONE moved sample — the board's own FLIPS, never the reader's
// cadence. `rows` stores the JSON-stringified WatchboardSnapshotRow[] the
// summarizer parses back; `signature` is the board signature used to detect
// motion (a sample is recorded only when the signature differs from the
// newest stored one).
// ─────────────────────────────────────────────────────────────────────────────

model WatchboardSnapshot {
  id        String   @id @default(cuid())
  builtAt   DateTime
  signature String
  hotCount  Int      @default(0)
  rows      String
  createdAt DateTime @default(now())

  @@index([builtAt])
}
