// ─────────────────────────────────────────────────────────────────────────────
// SECTION: Skylantern — devices, evidence, witnesses, audit events,
// subscriptions. Reconstructed from src/skylantern/server/repository.ts.
//
// IMPORTANT: the back-relation on Device is named `evidence` (the code uses
// `db.device.findUnique({ include: { _count: { select: { evidence: true } } } })`),
// and on EvidenceRecord the relation back to Device is named `device`.
// ─────────────────────────────────────────────────────────────────────────────

model Device {
  id              String   @id @default(cuid())
  externalId      String   @unique
  label           String
  domain          String   @default("WATER")
  primitive       String   @default("STATE")
  lat             Float
  lng             Float
  firmwareVersion String?
  hardwareKeyHint String?
  status          String   @default("ACTIVE")
  pricingBand     String?
  lastSeenAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  evidence EvidenceRecord[]
}

model EvidenceRecord {
  id                String   @id @default(cuid())
  deviceId          String
  hash              String   @unique
  previousHash      String?
  sequence          Int
  verificationState String   @default("CANDIDATE")
  tierTag           Int      @default(0)
  observedFact      String
  derivedEvent      String?
  decision          String?
  subject           String
  source            String
  observedAt        DateTime
  signedAt          DateTime @default(now())
  lat               Float    @default(0)
  lng               Float    @default(0)
  payload           String
  signature         String
  createdAt         DateTime @default(now())

  device      Device       @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  witnesses   Witness[]
  auditEvents AuditEvent[]
}

model Witness {
  id             String   @id @default(cuid())
  evidenceId     String
  witnessType    String
  witnessLabel   String
  witnessKeyHint String?
  signedAt       DateTime @default(now())

  evidence EvidenceRecord @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
