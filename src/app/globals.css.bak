@import "tailwindcss";
@import "tw-animate-css";

@custom-variant dark (&:is(.dark *));

@theme inline {
  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --font-sans: var(--font-geist-sans);
  --font-mono: var(--font-geist-mono);
  --color-sidebar-ring: var(--sidebar-ring);
  --color-sidebar-border: var(--sidebar-border);
  --color-sidebar-accent-foreground: var(--sidebar-accent-foreground);
  --color-sidebar-accent: var(--sidebar-accent);
  --color-sidebar-primary-foreground: var(--sidebar-primary-foreground);
  --color-sidebar-primary: var(--sidebar-primary);
  --color-sidebar-foreground: var(--sidebar-foreground);
  --color-sidebar: var(--sidebar);
  --color-chart-5: var(--chart-5);
  --color-chart-4: var(--chart-4);
  --color-chart-3: var(--chart-3);
  --color-chart-2: var(--chart-2);
  --color-chart-1: var(--chart-1);
  --color-ring: var(--ring);
  --color-input: var(--input);
  --color-border: var(--border);
  --color-destructive: var(--destructive);
  --color-accent-foreground: var(--accent-foreground);
  --color-accent: var(--accent);
  --color-muted-foreground: var(--muted-foreground);
  --color-muted: var(--muted);
  --color-secondary-foreground: var(--secondary-foreground);
  --color-secondary: var(--secondary);
  --color-primary-foreground: var(--primary-foreground);
  --color-primary: var(--primary);
  --color-popover-foreground: var(--popover-foreground);
  --color-popover: var(--popover);
  --color-card-foreground: var(--card-foreground);
  --color-card: var(--card);
  --radius-sm: calc(var(--radius) - 4px);
  --radius-md: calc(var(--radius) - 2px);
  --radius-lg: var(--radius);
  --radius-xl: calc(var(--radius) + 4px);

  /* VVU brand tokens */
  --color-vvu-sage: var(--vvu-sage);
  --color-vvu-lime: var(--vvu-lime);
  --color-vvu-ochre: var(--vvu-ochre);

  /* Status colors mapped to VVU SCADA palette */
  --color-verified: var(--vvu-lime);
  --color-repairing: var(--vvu-ochre);
  --color-violating: var(--vvu-crimson);
  --color-quarantined: var(--vvu-amber);
}

:root {
  --radius: 0.375rem;

  /* ══ VVU SCADA PALETTE ══ */
  /* Estate black canvas, lime/sage/ochre accents — 100% founder-owned */
  --vvu-bg: #060806;
  --vvu-panel: #0b0f0a;
  --vvu-sage: #6b8a40;
  --vvu-sage-bright: #8fb35a;
  --vvu-ochre: #f3e38a;
  --vvu-lime: #c8ff00;
  --vvu-text: #c9d4bd;
  --vvu-text-dim: #7a8a6e;
  --vvu-crimson: #e5484d;
  --vvu-amber: #e0a030;
  --vvu-teal: #2ea8a0;

  --background: #060806;
  --foreground: #c9d4bd;
  --card: #0b0f0a;
  --card-foreground: #c9d4bd;
  --popover: #0d120b;
  --popover-foreground: #c9d4bd;

  /* Primary = VVU lime */
  --primary: #c8ff00;
  --primary-foreground: #060806;

  --secondary: #141a11;
  --secondary-foreground: #c9d4bd;
  --muted: #131811;
  --muted-foreground: #7a8a6e;
  --accent: #182116;
  --accent-foreground: #d7e2c9;
  --destructive: #e5484d;
  --border: rgba(107, 138, 64, 0.25);
  --input: rgba(107, 138, 64, 0.3);
  --ring: #8fb35a;

  /* Status palette — VVU SCADA */
  --verified: #c8ff00;
  --repairing: #f3e38a;
  --violating: #e5484d;
  --quarantined: #e0a030;

  /* Chart palette — sage, ochre, lime, teal, crimson */
  --chart-1: #8fb35a;
  --chart-2: #f3e38a;
  --chart-3: #c8ff00;
  --chart-4: #2ea8a0;
  --chart-5: #e5484d;

  --sidebar: #0b0f0a;
  --sidebar-foreground: #c9d4bd;
  --sidebar-primary: #c8ff00;
  --sidebar-primary-foreground: #060806;
  --sidebar-accent: #182116;
  --sidebar-accent-foreground: #d7e2c9;
  --sidebar-border: rgba(107, 138, 64, 0.25);
  --sidebar-ring: #8fb35a;
}

.dark {
  --background: #060806;
  --foreground: #c9d4bd;
  --card: #0b0f0a;
  --card-foreground: #c9d4bd;
  --popover: #0d120b;
  --popover-foreground: #c9d4bd;
  --primary: #c8ff00;
  --primary-foreground: #060806;
  --secondary: #141a11;
  --secondary-foreground: #c9d4bd;
  --muted: #131811;
  --muted-foreground: #7a8a6e;
  --accent: #182116;
  --accent-foreground: #d7e2c9;
  --destructive: #e5484d;
  --border: rgba(107, 138, 64, 0.25);
  --input: rgba(107, 138, 64, 0.3);
  --ring: #8fb35a;
  --verified: #c8ff00;
  --repairing: #f3e38a;
  --violating: #e5484d;
  --quarantined: #e0a030;
  --chart-1: #8fb35a;
  --chart-2: #f3e38a;
  --chart-3: #c8ff00;
  --chart-4: #2ea8a0;
  --chart-5: #e5484d;
  --sidebar: #0b0f0a;
  --sidebar-foreground: #c9d4bd;
  --sidebar-primary: #c8ff00;
  --sidebar-primary-foreground: #060806;
  --sidebar-accent: #182116;
  --sidebar-accent-foreground: #d7e2c9;
  --sidebar-border: rgba(107, 138, 64, 0.25);
  --sidebar-ring: #8fb35a;
}

@layer base {
  * {
    @apply border-border outline-ring/50;
  }
  html {
    color-scheme: dark;
  }
  body {
    @apply bg-background text-foreground;
    background-image:
      radial-gradient(circle at 12% 18%, rgba(200, 255, 0, 0.04) 0, transparent 38%),
      radial-gradient(circle at 88% 12%, rgba(243, 227, 138, 0.03) 0, transparent 40%),
      radial-gradient(circle at 50% 110%, rgba(143, 179, 90, 0.03) 0, transparent 45%);
    background-attachment: fixed;
  }
}

/* ══ VVU UTILITY CLASSES ══ */

.font-mono {
  font-family: var(--font-geist-mono), ui-monospace, monospace;
}

.bg-grid {
  background-image:
    linear-gradient(to right, rgba(107, 138, 64, 0.12) 1px, transparent 1px),
    linear-gradient(to bottom, rgba(107, 138, 64, 0.12) 1px, transparent 1px);
  background-size: 22px 22px;
}

.bg-grid-fine {
  background-image:
    linear-gradient(to right, rgba(107, 138, 64, 0.08) 1px, transparent 1px),
    linear-gradient(to bottom, rgba(107, 138, 64, 0.08) 1px, transparent 1px);
  background-size: 10px 10px;
}

/* Status glows */
.glow-verified {
  box-shadow: 0 0 0 1px rgba(200, 255, 0, 0.35), 0 0 18px -2px rgba(200, 255, 0, 0.45);
}
.glow-repairing {
  box-shadow: 0 0 0 1px rgba(243, 227, 138, 0.35), 0 0 18px -2px rgba(243, 227, 138, 0.45);
}
.glow-violating {
  box-shadow: 0 0 0 1px rgba(229, 72, 77, 0.4), 0 0 18px -2px rgba(229, 72, 77, 0.5);
}

.text-verified { color: var(--verified); }
.text-repairing { color: var(--repairing); }
.text-violating { color: var(--violating); }
.text-quarantined { color: var(--quarantined); }

.bg-verified\/10 { background-color: rgba(200, 255, 0, 0.10); }
.bg-repairing\/10 { background-color: rgba(243, 227, 138, 0.10); }
.bg-violating\/10 { background-color: rgba(229, 72, 77, 0.12); }
.bg-quarantined\/10 { background-color: rgba(224, 160, 48, 0.12); }

.border-verified\/30 { border-color: rgba(200, 255, 0, 0.30); }
.border-repairing\/30 { border-color: rgba(243, 227, 138, 0.30); }
.border-violating\/30 { border-color: rgba(229, 72, 77, 0.30); }

@keyframes epistemic-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.35; }
}
.animate-epistemic-pulse {
  animation: epistemic-pulse 1.8s ease-in-out infinite;
}

@keyframes epistemic-sweep {
  0% { transform: translateX(-100%); }
  100% { transform: translateX(100%); }
}
.animate-sweep::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, transparent, rgba(200, 255, 0, 0.12), transparent);
  animation: epistemic-sweep 2.4s linear infinite;
}

* {
  scrollbar-width: thin;
  scrollbar-color: rgba(107, 138, 64, 0.4) transparent;
}
*::-webkit-scrollbar { width: 8px; height: 8px; }
*::-webkit-scrollbar-track { background: transparent; }
*::-webkit-scrollbar-thumb {
  background-color: rgba(107, 138, 64, 0.4);
  border-radius: 9999px;
}
*::-webkit-scrollbar-thumb:hover { background-color: rgba(143, 179, 90, 0.6); }

.codeblock {
  font-family: var(--font-geist-mono), ui-monospace, monospace;
  font-size: 12.5px;
  line-height: 1.55;
  tab-size: 2;
}

/* VVU header edge — 1px lime gradient that tints with guardian zone */
.vvu-header-edge {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--vvu-lime), transparent);
  opacity: 0.6;
}

/* VVU range input — native <input type="range"> styled to match the lime accent.
   Replaces the deleted @radix-ui/react-slider dependency (Golden Rule). */
.vvu-range {
  -webkit-appearance: none;
  appearance: none;
  height: 6px;
  border-radius: 9999px;
  background: linear-gradient(90deg,
    var(--vvu-lime) 0%,
    var(--vvu-lime) var(--vvu-range-pct, 50%),
    rgba(107, 138, 64, 0.2) var(--vvu-range-pct, 50%),
    rgba(107, 138, 64, 0.2) 100%);
  outline: none;
  cursor: pointer;
}
.vvu-range::-webkit-slider-thumb {
  -webkit-appearance: none;
  appearance: none;
  width: 16px;
  height: 16px;
  border-radius: 9999px;
  background: var(--vvu-lime);
  border: 2px solid #0b0f0a;
  box-shadow: 0 0 0 1px var(--vvu-lime);
  cursor: pointer;
  transition: transform 120ms;
}
.vvu-range::-webkit-slider-thumb:hover { transform: scale(1.18); }
.vvu-range::-moz-range-thumb {
  width: 16px;
  height: 16px;
  border-radius: 9999px;
  background: var(--vvu-lime);
  border: 2px solid #0b0f0a;
  cursor: pointer;
}
.vvu-range:focus-visible {
  box-shadow: 0 0 0 2px rgba(200, 255, 0, 0.3);
}
